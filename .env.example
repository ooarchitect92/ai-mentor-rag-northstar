# Claude / Anthropic is the mentor answer model.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_MAX_TOKENS=1800

# Retrieval embeddings. Use "hash" to run with only Claude, or "openai" for stronger semantic retrieval.
EMBEDDING_PROVIDER=hash
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=mentor_knowledge

REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=86400

ADMIN_TOKEN=change-me

WHATSAPP_VERIFY_TOKEN=change-me-whatsapp
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
META_APP_SECRET=
META_APP_ID=
FACEBOOK_APP_ID=
WHATSAPP_GRAPH_API_VERSION=v25.0
WHATSAPP_GRAPH_BASE=https://graph.facebook.com/v25.0
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_DEFAULT_COURSE=GENERAL
WHATSAPP_DEFAULT_MODE=doubt_solving
WHATSAPP_DEFAULT_LEVEL=beginner
WHATSAPP_MAX_REPLY_CHARS=3900
WHATSAPP_SESSION_TTL_SECONDS=2592000
WHATSAPP_START_TEMPLATE_NAME=hello_world
WHATSAPP_START_TEMPLATE_LANGUAGE=en_US
WHATSAPP_USE_MOCK=false
WHATSAPP_TEST_TO=918971392035

APP_HOST=0.0.0.0
APP_PORT=8000
TOP_K=5
MAX_CONTEXT_CHARS=9000
REQUEST_TIMEOUT_SECONDS=45
