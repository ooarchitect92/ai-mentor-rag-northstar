# NVIDIA Nemotron is primary; Gemini is the automatic fallback.
APP_ENVIRONMENT=development
MENTOR_PROVIDER=nvidia
MENTOR_FALLBACK_PROVIDER=gemini
MENTOR_POLICY_PROVIDER=gemini

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_TEMPERATURE=1
NVIDIA_TOP_P=0.95
NVIDIA_MAX_TOKENS=2048
NVIDIA_ENABLE_THINKING=false
NVIDIA_REASONING_BUDGET=2048
NVIDIA_POLICY_MAX_TOKENS=32

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models
GEMINI_MAX_OUTPUT_TOKENS=1800

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_MAX_TOKENS=1800

# Retrieval embeddings. Use "hash" without an embedding API, or "openai" for stronger semantic retrieval.
EMBEDDING_PROVIDER=hash
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=mentor_knowledge

REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=86400
QUESTION_ANSWER_FILE=/app/data/question_answers.txt
QUESTION_REPEAT_TTL_SECONDS=31536000

# Required: generate a long random token (for example, 32+ random bytes).
ADMIN_TOKEN=
ADMIN_DATABASE_FILE=/app/state/admin.sqlite3
ADMIN_STORAGE_VOLUME=ai-mentor-rag-northstar_admin_storage
ADMIN_UPLOAD_MAX_BYTES=20971520
ADMIN_UPLOAD_MAX_FILES=10
TRAINING_LEASE_TIMEOUT_SECONDS=900
TRAINING_RECOVERY_INTERVAL_SECONDS=60
RUNTIME_CONFIG_FILE=/app/data/runtime-config.json
MENTOR_SYSTEM_PROMPT_FILE=/app/data/mentor-system-prompt.txt

WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Recommended: register this service directly with Meta using a permanent HTTPS
# callback ending in /v1/whatsapp/ziplin/webhook.
WHATSAPP_WEBHOOK_CALLBACK_URL=
# Required for direct Meta webhooks. Used to verify X-Hub-Signature-256 before
# any payload is accepted or persisted.
WHATSAPP_APP_SECRET=
# Compatibility alias for WHATSAPP_APP_SECRET.
META_APP_SECRET=
META_APP_ID=
FACEBOOK_APP_ID=
WHATSAPP_GRAPH_API_VERSION=v25.0
WHATSAPP_GRAPH_BASE=https://graph.facebook.com/v25.0
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Runtime master switch. The dashboard can change this without restarting.
WHATSAPP_MESSAGING_ENABLED=true
# Give every inbound WhatsApp number CMA access. Teach is selected automatically.
# Enrollment records remain available for granting additional courses.
WHATSAPP_OPEN_CMA_ACCESS=true
WHATSAPP_DEFAULT_COURSE=CMA
WHATSAPP_DEFAULT_MODE=teach
WHATSAPP_DEFAULT_LEVEL=beginner
WHATSAPP_MAX_REPLY_CHARS=3900
WHATSAPP_MAX_MEDIA_BYTES=5242880
WHATSAPP_SESSION_TTL_SECONDS=2592000
# Public E.164 display number used by the app's wa.me feedback button (not the Meta phone-number ID).
WHATSAPP_FEEDBACK_NUMBER=
WHATSAPP_FEEDBACK_PREFILL="FEEDBACK\nPlease describe the change or error. You can also attach a screenshot."
WHATSAPP_FEEDBACK_SESSION_TTL_SECONDS=900
WHATSAPP_WEBHOOK_LEASE_TIMEOUT_SECONDS=360
WHATSAPP_WEBHOOK_RECOVERY_INTERVAL_SECONDS=15
WHATSAPP_WEBHOOK_MAX_ATTEMPTS=6
WHATSAPP_INBOUND_PROCESSING_TTL_SECONDS=300
WHATSAPP_MESSAGE_RETENTION_DAYS=90
# Legacy development/test compatibility only. Relay endpoints are disabled in
# production even when this value is present. Direct Meta delivery above does
# not use this token.
WHATSAPP_RELAY_TOKEN=
# Production: create a remotely-managed Cloudflare Tunnel and publish the API
# origin as http://api:8000. Quick trycloudflare tunnels are test-only.
CLOUDFLARE_TUNNEL_TOKEN=
NORTHSTAR_PUBLIC_BASE_URL=
FEEDBACK_MEDIA_DIRECTORY=/app/data/feedback-media
FEEDBACK_MAX_PER_SENDER_PER_DAY=10
FEEDBACK_MAX_STORAGE_BYTES=1073741824
FEEDBACK_RETENTION_DAYS=365
WHATSAPP_START_TEMPLATE_NAME=hello_world
WHATSAPP_START_TEMPLATE_LANGUAGE=en_US
WHATSAPP_USE_MOCK=false
WHATSAPP_TEST_TO=
# Semicolon/comma-separated phone:course pairs. Repeat a phone to assign multiple courses.
WHATSAPP_ENROLLMENTS=
# Docker path to the live, dashboard-editable Excel access-control workbook.
WHATSAPP_ENROLLMENTS_FILE=/app/data/whatsapp_enrollments.xlsx
# Private Google Sheet access control. When SHEET_ID is set, it becomes the sole authority.
WHATSAPP_ENROLLMENTS_GOOGLE_SHEET_ID=
WHATSAPP_ENROLLMENTS_GOOGLE_SHEET_RANGE=Enrollments!A:E
WHATSAPP_ENROLLMENTS_GOOGLE_REFRESH_SECONDS=60
GOOGLE_SERVICE_ACCOUNT_FILE=/app/secrets/google-service-account.json

APP_HOST=0.0.0.0
APP_PORT=8000
TOP_K=5
MAX_CONTEXT_CHARS=9000
STRICT_GROUNDING=true
MINIMUM_RETRIEVAL_SCORE=0.35
COURSE_RETRIEVAL_ENABLED=true
REQUEST_TIMEOUT_SECONDS=120
